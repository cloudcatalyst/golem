{
  "name": "golem-run",
  "version": "0.49.0",
  "description": "Golem (golem.run) — local-first proxy + unified MCP server that cuts Claude token spend and gives Claude local tools",
  "license": "Apache-2.0",
  "author": "Golem <paul@golem.run>",
  "homepage": "https://golem.run",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "golem": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vscode-extension/extension.js",
    "vscode-extension/render.js",
    "vscode-extension/package.json",
    "vscode-extension/README.md",
    "vscode-extension/media"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension": "node --test --test-reporter=spec vscode-extension/render.test.js",
    "verify:deps": "node scripts/verify-deps.mjs",
    "deps:shrinkwrap": "node scripts/make-shrinkwrap.mjs",
    "check": "npm run verify:deps && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "14.0.3",
    "env-paths": "3.0.0",
    "undici": "7.28.0",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "unpdf": "1.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.10.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "web-tree-sitter": "^0.26.10"
  }
}
