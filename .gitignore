# Node
node_modules/
dist/
dist-bin/
*.tsbuildinfo
npm-debug.log*

# npm pack artifacts (produced by the dev→stable promotion step)
*.tgz

# Coverage
coverage/

# Golem local state (repo root + any nested .golem/, e.g. under vscode-extension/)
**/.golem/state/
**/.golem/telemetry/
**/.golem/knowledge/
.golem/settings.local.json
.golem/proxy.pid
.golem/state/
.golem/telemetry/
.golem/webcache/
.golem/ccr/
.golem/knowledge/
.golem/notes/
.golem/distill/
.golem/tasks/
.golem/compact/
# R9.12: the loopback CA + leaf, and the CA's PRIVATE KEY. Machine-local by
# nature (the cert is issued for this machine's 127.0.0.1 and regenerated on
# demand), and a committed CA key would be trusted by every clone.
.golem/loopback/
# R9.8: the detached daemon's log.
.golem/proxy.log

# Claude Code personal settings
.claude/settings.local.json
.claude/worktrees/

# OS
.DS_Store
Thumbs.db
CLAUDE.local.md
.claude/rules/golem-*.local.md

# R8.10: generated from package-lock.json at release time (scripts/make-shrinkwrap.mjs).
# package-lock.json stays the single ground truth; committing both would guarantee drift.
npm-shrinkwrap.json

# Python bytecode from running the Headroom worker scripts locally (e.g. the
# tests/fixtures/headroom-worker-selftest.py run). Never an artifact we ship.
__pycache__/
*.pyc
