# Node
node_modules/
dist/
dist-bin/
*.tsbuildinfo
npm-debug.log*

# npm pack artifacts (produced by the dev→stable promotion step)
*.tgz

# Coverage
coverage/

# Golem local state (repo root + any nested .golem/, e.g. under vscode-extension/):
# deny-by-default. Everything under a .golem/ is machine-local (proxy pid/log,
# the loopback CA + PRIVATE KEY (R9.12), redacted conversation transcripts
# (R13.2, ADR-0007 §6), caches, telemetry, task/note/distill state,
# settings.local.json) UNLESS explicitly allowlisted below. A directory can't
# be un-ignored with `!` once matched, so this ignores .golem's *contents*
# (`.golem/*`) rather than the directory itself, which keeps the allowlisted
# entries below re-includable.
#
# This is the inverse of listing every subdirectory individually: a new
# .golem/<whatever>/ this project starts writing is safe (ignored) by default,
# rather than silently tracked until someone remembers to add it here.
#
# .golem/personas/ (ejected or hand-authored persona prompts) is allowlisted:
# persona prompts are ordinary project content, not per-clone-only, so
# they're trackable by git like anything else.
**/.golem/*
!.golem/settings.json
!.golem/managed-files.json
!.golem/personas

# Claude Code personal settings
.claude/settings.local.json
.claude/worktrees/

# OS
.DS_Store
Thumbs.db
CLAUDE.local.md
.claude/rules/golem-*.local.md

# R8.10: generated from package-lock.json at release time (scripts/make-shrinkwrap.mjs).
# package-lock.json stays the single ground truth; committing both would guarantee drift.
npm-shrinkwrap.json

# Python bytecode from running the Headroom worker scripts locally (e.g. the
# tests/fixtures/headroom-worker-selftest.py run). Never an artifact we ship.
__pycache__/
*.pyc
