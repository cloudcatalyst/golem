{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_BASE_URL": "http://localhost:4930"
  },
  "permissions": {
    "allow": [
      "Bash(golem:*)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch",
      "WebSearch",
      "mcp__golem__*"
    ],
    "ask": ["mcp__golem__wiki_upsert"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook post-tool-use",
            "timeout": 30,
            "async": false
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook web-fetch-post",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "golem hook notification"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "golem hook prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook web-fetch-pre",
            "timeout": 15,
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook session-start",
            "timeout": 15,
            "async": false
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "golem statusline"
  },
  "defaultMode": "default"
}
