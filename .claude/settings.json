{
  "permissions": {
    "allow": [
      "Bash(golem:*)",
      "mcp__golem"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_BASE_URL": "http://localhost:4930"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook post-tool-use",
            "async": false,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook web-fetch-post",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "golem hook notification"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "golem hook prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook web-fetch-pre",
            "async": false,
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "golem hook session-start",
            "async": false,
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "golem statusline"
  }
}
