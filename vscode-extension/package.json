{
  "name": "golem-vscode",
  "displayName": "Golem",
  "description": "Live Golem token-savings dashboard: compression stats, slider, and proxy status in a VS Code panel.",
  "version": "0.5.0",
  "publisher": "golem-run",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "golem",
          "title": "Golem",
          "icon": "media/golem.svg"
        }
      ]
    },
    "views": {
      "golem": [
        {
          "id": "golem.panel",
          "name": "Savings",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "golem.showPanel",
        "title": "Golem: Show Panel"
      },
      {
        "command": "golem.refresh",
        "title": "Golem: Refresh"
      },
      {
        "command": "golem.setSlider",
        "title": "Golem: Set Slider Level"
      },
      {
        "command": "golem.setAccount",
        "title": "Golem: Switch Upstream Account"
      },
      {
        "command": "golem.toggleProxy",
        "title": "Golem: Start/Stop Proxy Pipeline"
      },
      {
        "command": "golem.unwireProxy",
        "title": "Golem: Go Direct (Unwire Golem from Claude Code)"
      },
      {
        "command": "golem.wireProxy",
        "title": "Golem: Wire Claude Code Back to the Golem Proxy"
      },
      {
        "command": "golem.update",
        "title": "Golem: Update to Latest"
      },
      {
        "command": "golem.menu",
        "title": "Golem: Actions Menu"
      },
      {
        "command": "golem.configure",
        "title": "Golem: Configure Settings"
      }
    ],
    "configuration": {
      "title": "Golem",
      "properties": {
        "golem.pollSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "How often (seconds) the panel and status bar poll the golem CLI as a background safety net. Slider/state changes update immediately (optimistically for in-editor changes, via a file watcher for external ones), so this only needs to catch proxy up/down and savings drift."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "deploy:local": "node deploy-local.mjs"
  }
}
