; Golem supply-chain posture (R8.10 — spec Decision 53's invariant 4 taken
; seriously: Golem ships no third-party bytes, so the few it *depends* on are
; treated as reviewed code).
;
; Verified against npm 11.12.1 locally rather than assumed (verification-notes
; §98): `min-release-age` is resolved by npm into a rolling
; `before = <timestamp>`, so it genuinely refuses same-day releases at resolution
; time rather than being an inert key.

; Every `npm install <pkg>` records an exact version, never a `^` range. Direct
; dependencies are pinned in package.json to match; `npm run verify:deps`
; enforces it.
save-exact=true

; Refuse to resolve anything published in the last 2 days. A compromised release
; is usually yanked within hours, and nothing here needs a package the day it
; ships. Does not affect `npm ci`, which installs from the lockfile.
min-release-age=2
